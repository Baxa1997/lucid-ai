# ─────────────────────────────────────────────────────────
#  Lucid AI — Environment Variables
# ─────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/lucid?schema=public"

# ── Supabase Auth ───────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── Encryption (for storing OAuth tokens) ───────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-encryption-key-here"

# ── AI Agent Service ────────────────────────────
PYTHON_BACKEND_URL="http://localhost:8000"

# ── Internal API Key (server-to-server fallback) ─
# Optional — only needed if ai_engine requires X-Internal-Key
# when Bearer JWT is not available
INTERNAL_API_KEY=""

# ── Local dev quota bypass (UI only) ────────────
# Set to "1" to disable plan/token-limit gating in the dashboard composer,
# workspace chat, and PlanUsageStrip — useful for repeated local testing
# without resetting usage. Only honored when NODE_ENV != production.
# The "Dev bypass" badge appears next to your plan name when active.
NEXT_PUBLIC_DEV_BYPASS_QUOTA="0"

# ── Vertex AI (Gemini) ──────────────────────────
# Used by /api/intent-check. The frontend matches the ai_engine: all
# Gemini traffic goes through Vertex AI with Application Default
# Credentials. The old AI Studio path (GEMINI_API_KEY) is removed.
#
# Setup (local dev):
#   1. Install gcloud CLI
#   2. `gcloud auth application-default login`
#   3. Set GOOGLE_CLOUD_PROJECT to your GCP project ID
#
# Setup (prod / CI):
#   Use a service account JSON file and point
#   GOOGLE_APPLICATION_CREDENTIALS at it (Workload Identity also works).
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
# Path to service account JSON — only if NOT using `gcloud auth login`.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
