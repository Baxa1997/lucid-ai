# Dependencies
# No trailing slash: also ignores a `node_modules` *symlink* (the preview
# step symlinks node_modules to a shared cache; `node_modules/` matches only
# real directories, so the symlink leaked into git and broke Vercel installs
# with `ENOTDIR: mkdir node_modules`).
node_modules
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lucid AI
.lucid/
.claude/
